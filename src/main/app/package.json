    "selfsigned": "^5.5.0",
    "start-server-and-test": "^2.0.12",
    "typescript": "5.8",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
