{
  "name": "kouta-ui",
  "version": "0.1.0",
  "homepage": "/kouta",
  "private": true,
  "scripts": {
    "prepare": "cd ../../../ && husky",
    "start": "vite dev",
    "start:integration": "cross-env DISABLE_LOCAL_PROXY=true NODE_ENV=test pnpm run start",
    "start:integration:debug": "cross-env VITE_CIMODE=1 NODE_ENV=test pnpm run start",
    "build": "vite build",
    "build:test": "cross-env VITE_CIMODE=1 vite build",
    "preview:watch": "pnpm run build:test -- --watch & pnpm run serve:test",
    "serve:test": "node test-server.js",
    "test": "vitest",
    "lint": "eslint --max-warnings=0 './src/**/*.{js,jsx,ts,tsx}' './playwright/**/*.ts'",
    "lint:fix": "eslint --fix './src/**/*.{js,jsx,ts,tsx}' './playwright/**/*.ts'",
    "tsc": "tsc",
    "test:integration": "pnpm run build:test && START_SERVER_AND_TEST_INSECURE=1 start-server-and-test 'pnpm run serve:test' https://localhost:3000/kouta 'pnpm exec playwright test'",
    "test:ci": "CI=true pnpm run test && pnpm run test:integration",
    "analyze": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@lexical/html": "^0.38.2",
    "@lexical/link": "^0.38.2",
    "@lexical/list": "^0.38.2",
    "@lexical/react": "^0.38.2",
    "@lexical/rich-text": "^0.38.2",
    "@lexical/selection": "^0.38.2",
    "@lexical/table": "^0.38.2",
    "@lexical/utils": "^0.38.2",
    "@opetushallitus/virkailija-ui-components": "^0.4.8",
    "@react-spring/web": "^9.7.3",
    "@statelyai/inspect": "^0.7.2",
    "@tanstack/react-query": "^5.103.1",
    "@xstate/react": "^6.1.0",
    "axios": "1.20.0",
    "date-fns": "^2.30.0",
    "debounce-promise": "^3.1.2",
    "final-form": "^5.0.1",
    "final-form-arrays": "^4.0.1",
    "http-status-codes": "^2.3.0",
    "i18next": "^23.4.2",
    "i18next-http-backend": "^3.0.2",
    "immer": "^10.1.1",
    "lexical": "^0.38.2",
    "lodash-es": "^4.18.1",
    "oph-urls-js": "github:Opetushallitus/oph-urls-js",
    "polished": "^4.3.1",
    "pretty-bytes": "^6.1.1",
    "query-string": "^9.2.1",
    "rc-tooltip": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-final-form": "7.0.1",
    "react-final-form-arrays": "^5.0.0",
    "react-i18next": "^13.0.3",
    "react-router": "^7.18.4",
    "react-select": "^4.3.1",
    "react-simple-timefield": "^3.3.1",
    "react-use": "^17.6.0",
    "striptags": "^3.2.0",
    "styled-components": "^5.3.3",
    "styled-css-grid": "^1.3.0",
    "styled-system": "^5.1.5",
    "ts-pattern": "^5.7.1",
    "xstate": "^5.33.2"
